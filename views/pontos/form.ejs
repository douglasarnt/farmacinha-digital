<h1 class="h3 mb-3"><%= titulo %></h1>

<% if (erros) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% erros.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="POST" action="<%= editando ? '/pontos/' + item._id + '?_method=PUT' : '/pontos' %>" class="card card-body">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Nome *</label>
      <input type="text" name="nome" class="form-control" value="<%= item.nome || '' %>" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Tipo *</label>
      <select name="tipo" class="form-select" required>
        <% TIPOS.forEach(t => { %><option value="<%= t %>" <%= item.tipo === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div class="col-12">
      <label class="form-label">Endereço *</label>
      <input type="text" name="endereco" class="form-control" value="<%= item.endereco || '' %>" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Funcionamento</label>
      <input type="text" name="funcionamento" class="form-control" value="<%= item.funcionamento || '' %>" placeholder="Ex.: Seg a Sex, 8h às 18h">
    </div>
    <div class="col-md-6">
      <label class="form-label">Telefone</label>
      <input type="text" name="telefone" class="form-control" value="<%= item.telefone || '' %>" placeholder="(51) 0000-0000">
    </div>
    <div class="col-12">
      <label class="form-label">Orientações de descarte</label>
      <textarea name="orientacoes" rows="3" class="form-control" placeholder="Ex.: Leve o medicamento na embalagem original, sem retirar a bula."><%= item.orientacoes || '' %></textarea>
    </div>
    <div class="col-12">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="ativo" id="ativo" <%= item.ativo ? 'checked' : '' %>>
        <label class="form-check-label" for="ativo">Ponto ativo (recebendo medicamentos)</label>
      </div>
    </div>
  </div>
  <div class="mt-4 d-flex gap-2">
    <button class="btn btn-brand"><i class="bi bi-check-circle"></i> Salvar</button>
    <a href="/pontos" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>
