<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0"><%= item.nome %> <span class="badge text-bg-<%= item.ativo ? 'success' : 'secondary' %> fs-6"><%= item.ativo ? 'Ativo' : 'Inativo' %></span></h1>
  <div class="d-flex gap-2">
    <a href="/pontos/<%= item._id %>/editar" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
    <a href="/pontos" class="btn btn-outline-secondary">Voltar</a>
  </div>
</div>
<div class="card card-body">
  <dl class="row mb-0">
    <dt class="col-sm-3">Tipo</dt><dd class="col-sm-9"><%= item.tipo %></dd>
    <dt class="col-sm-3">Endereço</dt><dd class="col-sm-9"><%= item.endereco %></dd>
    <dt class="col-sm-3">Funcionamento</dt><dd class="col-sm-9"><%= item.funcionamento || '-' %></dd>
    <dt class="col-sm-3">Telefone</dt><dd class="col-sm-9"><%= item.telefone || '-' %></dd>
    <dt class="col-sm-3">Orientações</dt><dd class="col-sm-9"><%= item.orientacoes || '-' %></dd>
  </dl>
</div>
