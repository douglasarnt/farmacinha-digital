<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Pontos de coleta</h1>
  <a href="/pontos/novo" class="btn btn-brand"><i class="bi bi-plus-circle"></i> Novo ponto</a>
</div>

<form method="GET" action="/pontos" class="card card-body mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label small mb-1">Pesquisar por nome</label>
      <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Ex.: Agafarma">
    </div>
    <div class="col-6 col-md-3">
      <label class="form-label small mb-1">Tipo</label>
      <select name="tipo" class="form-select">
        <option value="">Todos</option>
        <% TIPOS.forEach(t => { %><option value="<%= t %>" <%= tipo === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small mb-1">Ativo</label>
      <select name="ativo" class="form-select">
        <option value="">Todos</option>
        <option value="sim" <%= ativo === 'sim' ? 'selected' : '' %>>Sim</option>
        <option value="nao" <%= ativo === 'nao' ? 'selected' : '' %>>Não</option>
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button class="btn btn-brand flex-fill"><i class="bi bi-search"></i> Filtrar</button>
      <a href="/pontos" class="btn btn-outline-secondary">Limpar</a>
    </div>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Nome</th><th>Tipo</th><th>Endereço</th><th>Funcionamento</th><th>Telefone</th><th class="text-end">Ações</th></tr>
      </thead>
      <tbody>
        <% if (itens.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">Nenhum ponto de coleta encontrado.</td></tr>
        <% } %>
        <% itens.forEach(p => { %>
          <tr>
            <td class="fw-semibold"><%= p.nome %> <% if (!p.ativo) { %><span class="badge text-bg-secondary">Inativo</span><% } %></td>
            <td><%= p.tipo %></td>
            <td><%= p.endereco %></td>
            <td><%= p.funcionamento || '-' %></td>
            <td><%= p.telefone || '-' %></td>
            <td class="text-end text-nowrap">
              <a href="/pontos/<%= p._id %>" class="btn btn-sm btn-outline-secondary" title="Visualizar"><i class="bi bi-eye"></i></a>
              <a href="/pontos/<%= p._id %>/editar" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
              <form action="/pontos/<%= p._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Excluir este ponto de coleta?');">
                <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="text-muted small mt-2"><%= itens.length %> registro(s)</p>
