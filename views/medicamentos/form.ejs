<h1 class="h3 mb-3"><%= titulo %></h1>

<% if (erros) { %>
  <div class="alert alert-danger"><ul class="mb-0"><% erros.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="POST" action="<%= editando ? '/medicamentos/' + item._id + '?_method=PUT' : '/medicamentos' %>" class="card card-body">
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">Nome *</label>
      <input type="text" name="nome" class="form-control" value="<%= item.nome || '' %>" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Dosagem *</label>
      <input type="text" name="dosagem" class="form-control" value="<%= item.dosagem || '' %>" placeholder="Ex.: 50 mg" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Validade *</label>
      <input type="date" name="validade" class="form-control" value="<%= inputData(item.validade) %>" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Quantidade (comprimidos, ml...)</label>
      <input type="number" min="0" name="quantidade" class="form-control" value="<%= item.quantidade ?? '' %>">
    </div>
    <div class="col-12">
      <div class="form-check">
        <input class="form-check-input" type="checkbox" name="descartado" id="descartado" <%= item.descartado ? 'checked' : '' %>>
        <label class="form-check-label" for="descartado">Já foi descartado</label>
      </div>
    </div>
  </div>
  <div class="mt-4 d-flex gap-2">
    <button class="btn btn-brand"><i class="bi bi-check-circle"></i> Salvar</button>
    <a href="/medicamentos" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>
