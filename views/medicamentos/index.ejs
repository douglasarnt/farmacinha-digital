<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <h1 class="h3 mb-0">Medicamentos</h1>
  <a href="/medicamentos/novo" class="btn btn-brand"><i class="bi bi-plus-circle"></i> Novo medicamento</a>
</div>

<form method="GET" action="/medicamentos" class="card card-body mb-3">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label small mb-1">Pesquisar por nome</label>
      <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Ex.: Losartana">
    </div>
    <div class="col-6 col-md-3">
      <label class="form-label small mb-1">Validade</label>
      <select name="validade" class="form-select">
        <option value="">Todas</option>
        <option value="vencidos" <%= validade === 'vencidos' ? 'selected' : '' %>>Vencidos</option>
        <option value="avencer" <%= validade === 'avencer' ? 'selected' : '' %>>Vencem em 30 dias</option>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small mb-1">Descartado</label>
      <select name="descartado" class="form-select">
        <option value="">Todos</option>
        <option value="sim" <%= descartado === 'sim' ? 'selected' : '' %>>Sim</option>
        <option value="nao" <%= descartado === 'nao' ? 'selected' : '' %>>Não</option>
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <button class="btn btn-brand flex-fill"><i class="bi bi-search"></i> Filtrar</button>
      <a href="/medicamentos" class="btn btn-outline-secondary">Limpar</a>
    </div>
  </div>
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr><th>Nome</th><th>Dosagem</th><th>Validade</th><th>Qtd.</th><th>Situação</th><th class="text-end">Ações</th></tr>
      </thead>
      <tbody>
        <% if (itens.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">Nenhum medicamento encontrado.</td></tr>
        <% } %>
        <% itens.forEach(m => { const s = statusValidade(m, hoje); %>
          <tr>
            <td class="fw-semibold"><%= m.nome %></td>
            <td><%= m.dosagem %></td>
            <td><%= fmtData(m.validade) %></td>
            <td><%= m.quantidade ?? '-' %></td>
            <td><span class="badge text-bg-<%= s.classe %>"><%= s.texto %></span></td>
            <td class="text-end text-nowrap">
              <a href="/medicamentos/<%= m._id %>" class="btn btn-sm btn-outline-secondary" title="Visualizar"><i class="bi bi-eye"></i></a>
              <a href="/medicamentos/<%= m._id %>/editar" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
              <form action="/medicamentos/<%= m._id %>?_method=DELETE" method="POST" class="d-inline"
                    onsubmit="return confirm('Excluir este medicamento e os lembretes ligados a ele?');">
                <button class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="text-muted small mt-2"><%= itens.length %> registro(s)</p>
