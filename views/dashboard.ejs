<h1 class="h3 mb-4">Painel</h1>

<div class="row g-3 mb-4">
  <div class="col-6 col-xl-3">
    <a href="/medicamentos?descartado=nao" class="card card-stat text-decoration-none h-100">
      <div class="card-body"><div class="stat-icon bg-brand-soft"><i class="bi bi-capsule"></i></div>
        <div class="stat-num"><%= totalMed %></div><div class="text-muted">Medicamentos guardados</div></div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a href="/medicamentos?validade=vencidos&descartado=nao" class="card card-stat text-decoration-none h-100">
      <div class="card-body"><div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-octagon"></i></div>
        <div class="stat-num"><%= vencidos %></div><div class="text-muted">Vencidos (descartar!)</div></div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a href="/medicamentos?validade=avencer&descartado=nao" class="card card-stat text-decoration-none h-100">
      <div class="card-body"><div class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-hourglass-split"></i></div>
        <div class="stat-num"><%= aVencer %></div><div class="text-muted">Vencem em 30 dias</div></div>
    </a>
  </div>
  <div class="col-6 col-xl-3">
    <a href="/lembretes?ativo=sim" class="card card-stat text-decoration-none h-100">
      <div class="card-body"><div class="stat-icon bg-info-subtle text-info-emphasis"><i class="bi bi-alarm"></i></div>
        <div class="stat-num"><%= lembretesAtivos %></div><div class="text-muted">Lembretes ativos</div></div>
    </a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header bg-white fw-semibold">Atenção: vencidos e próximos do vencimento</div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Medicamento</th><th>Validade</th><th>Situação</th></tr></thead>
          <tbody>
            <% if (proximos.length === 0) { %>
              <tr><td colspan="3" class="text-center text-muted py-4">Nenhum medicamento exige atenção. 🎉</td></tr>
            <% } %>
            <% proximos.forEach(m => { const s = statusValidade(m, hoje); %>
              <tr>
                <td><a href="/medicamentos/<%= m._id %>"><%= m.nome %></a> <small class="text-muted"><%= m.dosagem %></small></td>
                <td><%= fmtData(m.validade) %></td>
                <td><span class="badge text-bg-<%= s.classe %>"><%= s.texto %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header bg-white fw-semibold">Acesso rápido</div>
      <div class="card-body d-grid gap-2">
        <a class="btn btn-brand" href="/medicamentos/novo"><i class="bi bi-plus-circle"></i> Cadastrar medicamento</a>
        <a class="btn btn-outline-brand" href="/lembretes/novo"><i class="bi bi-alarm"></i> Novo lembrete</a>
        <a class="btn btn-outline-brand" href="/pontos/novo"><i class="bi bi-geo-alt"></i> Novo ponto de coleta</a>
        <a class="btn btn-outline-secondary" href="/pontos?ativo=sim"><i class="bi bi-recycle"></i> Onde descartar (<%= pontosAtivos %> pontos ativos)</a>
      </div>
    </div>
  </div>
</div>
